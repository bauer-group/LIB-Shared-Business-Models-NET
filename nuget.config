<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Packages restore into the default global packages folder (~/.nuget/packages), not into
       the repository. A restore cache inside the checkout is scanned by GitHub's automatic
       dependency submission: every restored .nuspec/.nupkg under ./Packages became its own
       "manifest", so Dependabot alerts pointed at Packages/<id>/<version>/ paths that do not
       exist in git and Dependabot could never open a fix PR for them. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
